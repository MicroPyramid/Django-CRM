  "tags": [
    { "name": "Peak date", "color": "red", "description": "Falls in the peak season. The date will not hold for long" },
    { "name": "Destination", "color": "violet", "description": "Event away from the home city" },
    { "name": "Corporate", "color": "blue", "description": "Company event rather than a private celebration" },
    { "name": "Referral", "color": "teal", "description": "Introduced by a past client or a venue" }
