    "account.plural": "Clients"
  },
  "lead_pipeline": {
    "name": "Enquiries",
    "description": "First enquiry through to a signed booking.",
    "stages": [
      { "name": "New enquiry", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "Consultation booked", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "Proposal sent", "order": 3, "stage_type": "open", "color": "#6366F1" },
      { "name": "Date held", "order": 4, "stage_type": "open", "color": "#8B5CF6" },
      { "name": "Contract sent", "order": 5, "stage_type": "open", "color": "#F59E0B" },
      { "name": "Booked", "order": 6, "stage_type": "won", "color": "#10B981" },
      { "name": "Date lost", "order": 7, "stage_type": "lost", "color": "#EF4444" }
    ]
  },
  "case_pipeline": {
    "name": "Event delivery",
    "description": "Changes and problems raised once a booking is confirmed.",
    "stages": [
      { "name": "New issue", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "With planner", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "Awaiting vendor", "order": 3, "stage_type": "open", "color": "#F59E0B" },
      { "name": "Awaiting client", "order": 4, "stage_type": "open", "color": "#EC4899" },
      { "name": "Resolved", "order": 5, "stage_type": "closed", "color": "#10B981" },
      { "name": "Not our remit", "order": 6, "stage_type": "rejected", "color": "#EF4444" }
    ]
  },
  "task_pipeline": {
    "name": "Planning workflow",
    "description": "Run-up work for a booked event.",
    "stages": [
      { "name": "To do", "order": 1, "stage_type": "open", "color": "#6B7280" },
      { "name": "Scheduled", "order": 2, "stage_type": "open", "color": "#3B82F6" },
      { "name": "In progress", "order": 3, "stage_type": "in_progress", "color": "#8B5CF6" },
      { "name": "Done", "order": 4, "stage_type": "completed", "color": "#10B981" }
    ]
  },
  "custom_fields": [
    { "target": "Lead", "key": "event_type", "label": "Event type", "field_type": "dropdown", "is_filterable": true, "display_order": 1,
      "options": [
        { "value": "wedding", "label": "Wedding" },
        { "value": "reception", "label": "Reception" },
        { "value": "engagement", "label": "Engagement party" },
        { "value": "milestone", "label": "Milestone celebration" },
        { "value": "corporate", "label": "Corporate event" },
        { "value": "conference", "label": "Conference" },
        { "value": "gala", "label": "Gala or fundraiser" }
      ] },
    { "target": "Lead", "key": "event_date", "label": "Event date", "field_type": "date", "is_filterable": true, "display_order": 2 },
    { "target": "Lead", "key": "guest_count", "label": "Guest count", "field_type": "number", "is_filterable": true, "display_order": 3 },
    { "target": "Lead", "key": "venue", "label": "Venue", "field_type": "text", "display_order": 4 },
    { "target": "Lead", "key": "budget", "label": "Budget", "field_type": "number", "display_order": 5 },
    { "target": "Lead", "key": "venue_confirmed", "label": "Venue confirmed", "field_type": "checkbox", "display_order": 6 }
